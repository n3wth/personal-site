---
import Head from '@astrojs/starlight/components/Head.astro'

const { entry, head } = Astro.locals.starlightRoute

// Cloudflare serves documentation at slashless URLs, as listed in the sitemap.
for (const { tag, attrs } of head) {
  if (tag === 'link' && attrs?.rel === 'canonical' && typeof attrs.href === 'string') {
    attrs.href = attrs.href.replace(/\/$/, '')
  }
  if (tag === 'meta' && attrs?.property === 'og:url' && typeof attrs.content === 'string') {
    attrs.content = attrs.content.replace(/\/$/, '')
  }
}
---

<Head />
<meta name="twitter:title" content={entry.data.title} />
<meta name="twitter:description" content={entry.data.description} />
